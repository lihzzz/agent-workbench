@@ -32,6 +32,39 @@ interface TerminalEntry {
 
 export const terminals = new Map<string, TerminalEntry>();
 
+/**
+ * Ensure the PTY child process gets a UTF-8 locale.
+ *
+ * When the app is launched from Finder/Dock (or a packaged build) rather than a
+ * login shell, the GUI process does NOT inherit `LANG`/`LC_*`, so the spawned
+ * shell falls back to the `C` locale. Programs like `ls` then replace every
+ * non-ASCII byte with `?` (e.g. Chinese filenames show as `??????`). Injecting
+ * a UTF-8 locale fixes the mojibake at the source.
+ *
+ * Only fills in missing/non-UTF-8 values — an existing UTF-8 `LANG` is kept.
+ */
+function withUtf8Locale(env: NodeJS.ProcessEnv): NodeJS.ProcessEnv {
+  // Windows is not locale-driven the same way; cmd/PowerShell use code pages.
+  if (process.platform === "win32") return env;
+
+  const isUtf8 = (v: string | undefined): boolean =>
+    !!v && /utf-?8/i.test(v);
+
+  // If any locale var already requests UTF-8, the env is fine as-is.
+  if (isUtf8(env.LC_ALL) || isUtf8(env.LC_CTYPE) || isUtf8(env.LANG)) {
+    return env;
+  }
+
+  // Derive a sensible UTF-8 locale: reuse the language portion of an existing
+  // (non-UTF-8) LANG if present, else fall back to a widely-available default.
+  const base = (env.LANG || "").split(".")[0];
+  const fallback = base && /^[a-z]{2}(_[A-Z]{2})?$/.test(base)
+    ? `${base}.UTF-8`
+    : "en_US.UTF-8";
+
+  return { ...env, LANG: fallback, LC_CTYPE: fallback };
+}
+
 let ptyModule: { spawn: (...args: unknown[]) => TerminalEntry["pty"] } | null = null;
 
